{
	"LogName": "Custom Fixed Dialogue",
	"Action": "EditData",
	"Target": "Characters/Dialogue/Seren",
	"Entries": {
		"Event.cs.1736": "$q -1 null#응, 아가?#$r -1 0 danceAsk#같이 춤춰요.#$r -1 0 null#아무것도 아니에요.",
		"Event.cs.1738": "$q -1 null#응?#$r -1 0 danceAsk#같이 춤춰요.#$r -1 0 null#아무것도 아니에요...",

		"NPC.cs.3980": "...!!$l#$b#그래, 아가. 우리 영원을 약속하자.$4#$b#꽃은 아가가 먼저 줬으니, 청혼은 내가 먼저 하고 싶었는데.$4#$b#아가에게 청혼을 받다니, 너무 두근거리고 행복해. 오늘을 절대 잊지 못할 거야.$6#$b#고마워, 사랑해.$1#$b#3일 뒤에 보자. 아가는 예쁜 의상만 준비하렴.$1",

		"NPC.cs.4083": "그거 아니? {0}이(가)", 
		"NPC.cs.4084": " '{0}'을(를) 사랑한다는 거?",
		"NPC.cs.4086": "{0}이(가) '{1}'을(를) 사랑한대. ", 
		"NPC.cs.4088": "나한테 직접 얘기해 줬단다.",
		"NPC.cs.4089": "나한테 직접 얘기해 줬단다.",
		"NPC.cs.4106": "{0}와(과) 친구가 되고 싶다면, '{1}'을(를) 주면 기뻐할 거야.", 
		"NPC.cs.4118": " 한번 줬더니, 정말 좋아하더라.",
		"NPC.cs.4120": " 한번 줬더니, 정말 좋아하더라.",
		"NPC.cs.4141": "{0}은(는) '{1}'을(를) 정말 싫어해. 직접 들은 얘기야.", 
		"NPC.cs.4144": "{0}은(는) '{1}'을(를) 정말 싫어해. 직접 들은 얘기야.", 
		"NPC.cs.4146": "경고 한마디 할게. ",
		"NPC.cs.4149": "{0}은(는) '{1}'을(를) 정말 싫어해. 선물로 추천하지는 않아.",
		"NPC.cs.4152": "{0}은(는) '{1}'을(를) 정말 싫어해. 선물로 추천하지는 않아.",
		"NPC.cs.4153": "{0}은(는) '{1}'을(를) 정말 싫어해. 선물로 추천하지는 않아.",
		"NPC.cs.4154": "{0}은(는) '{1}'을(를) 정말 싫어해. 선물로 추천하지는 않아.",
		"NPC.cs.4170": " 오래 전에 한번 줬었는데, 표정이...",
		"NPC.cs.4172": " 왜 그런지는 잘 모르겠단다.",
		"NPC.cs.4174": " 왜 그런지는 잘 모르겠단다.",
		"NPC.cs.4176": " 알레르기 있는 것 같아.", 
		"NPC.cs.4178": " 알레르기 있는 것 같아.", 
		"NPC.cs.4180": " 취향은 다들 다른 거니까.",
		"NPC.cs.4182": "{0}은(는) '{1}'을(를) 정말 싫어해. 자세히 알면 안 좋아. 날 믿으렴.",


		"NPC.cs.4406": "아가... 오늘 일찍 쉬어도 되겠니? 미안, 피곤하네.$2",
		"NPC.cs.4420": "내가 너무 당연하게 생각했던 걸까...$2",
		"NPC.cs.4421": "심심하구나... 결혼 후 삶이 이렇게 달라질 줄은 몰랐는데.$s",
		"NPC.cs.4422": "아가. 요즘 내게 부쩍 소홀해진 것 같아.$2#$b#내가 아가를 챙기지 못한 거니?$2",
		"NPC.cs.4423": "내 말투가 너무 아줌마 같아? 그렇다면 고칠게.$2",
		"NPC.cs.4424": "다음에. 다음에 얘기하자, 아가.",
		"NPC.cs.4426": "오늘은 힘이 없구나. 미안.$2",
		"NPC.cs.4427": "...... 오늘 내 모습이 별로인가 보구나.$s#$b#네 눈빛에서 느껴져.$s",
		"NPC.cs.4429": "...... 오늘 내 모습이 별로인가 보구나.$s#$b#네 눈빛에서 느껴져.$s",
		"NPC.cs.4431": "...$s#$e#@, 갇혔다는 느낌 들 때 없니?$s",
		"NPC.cs.4432": "내가 이렇게 바보 같아진 이유는, 상처받기 싫어서 모르는 척하고 있기 때문이겠지...$s",
		"NPC.cs.4434": "으응... 왜, @? 자고 싶어...$s",
		"NPC.cs.4435": "오늘은 그냥 일어나고 싶지 않아.$s",
		"NPC.cs.4437": "으으응... 아무것도 하기 싫구나.$s",
		"NPC.cs.4438": "......$a#$e$악몽을 꿨어, 그게 다란다.$s",

		"NPC.cs.4439": "@, 우리 아이가 생기면 더 행복해질까?$1",
		"NPC.cs.4440": "우리 입양 신청이 잘 진행되면 좋겠다. 아가, 너를 닮았으면 좋겠구나.$l#$b#아, 아이가 생기면 아가가 두 명이 되겠구나!",
		"NPC.cs.4441": "@, 우리 입양 서류 제출했어. 이제 기다리는 일만 남았네.$l#$b#아, 아이가 생기면 아가가 두 명이 되겠구나!",
		"NPC.cs.4449": "... 진짜 아기를 돌보는 건 보통 일이 아니구나... 아가, 미안. 움직일 힘이 없어...$2",
		"NPC.cs.4452": "... 진짜 아기를 돌보는 건 보통 일이 아니구나... 아가, 미안. 움직일 힘이 없어...$2",

		"NPC.cs.4455": "일어났니, 아가? 부은 얼굴도 귀엽네. 세수하고 오렴.",
		"NPC.cs.4462": "아가, 일어났니? 오늘 일찍 일어나서 작물에 물을 줬단다.#$b#너무 무리하지 말렴. *쪽*$1",
		"NPC.cs.4470": "작물에 물을 주려고 했는데, 이미 완벽하지 뭐니? 역시 아가는 못 하는 게 없구나.$1",
		"NPC.cs.4481": "아침에 울타리를 수리했단다. 새 거나 다름없을 거야.",
		"NPC.cs.4489": "아가, 방을 조금 꾸며봤는데. 어떠니?#$b#네 마음에 안 들면 치워도 좋단다.",
		"NPC.cs.4490": "방을 조금 꾸미고 싶었는데, 이미 완벽하네.$1",
		"NPC.cs.4496": "@, 새로 벽지를 바꿔봤어. 어때?#$b#이상해도 봐 주련.",
		"NPC.cs.4497": "아가, 새로 바닥을 바꿔봤어.#$b#어떠니? 마음에 안 들면 바꿔도 좋아.",
		"NPC.cs.4498": "*하품* 졸리는구나.#$b#미안해, 조금만 더 잘게.",
		"NPC.cs.4499": "미안해, 아가. 오늘따라 침대가 너무 폭신하구나......",
		"NPC.cs.4500": "아가. 집을 꾸미는 것은 좋지만 발 디딜 틈이 없어... 그래도 공간이 있어야 우리가 뭘 할 수 있지 않겠니?#$b#같이 정리할까?$1",

		"ExtraDialogue_Mines_PlayerKilled_Spouse_PlayerMale": "아가! 다행이야. 네가 잘못된 줄 알고 어찌나 놀랐는지... 내게 이제 너밖에 없는데 네 몸을 소중히 여기지 않으면 어떡하니... 내 능력을 쓸 일이 없었으면 좋겠어.$2",
		"ExtraDialogue_Mines_PlayerKilled_Spouse_PlayerFemale": "아가! 다행이야. 네가 잘못된 줄 알고 어찌나 놀랐는지... 내게 이제 너밖에 없는데 네 몸을 소중히 여기지 않으면 어떡하니... 내 능력을 쓸 일이 없었으면 좋겠어.$2",
		"ExtraDialogue_NewChild_SecondChild1": "나의... 아니, 우리의 가족들... 아가, 나는 이렇게 큰 행복을 느껴본 적이 없어.",
		"ExtraDialogue_NewChild_SecondChild2": "우리 사랑스러운 아이들... @, 너무 행복해.",
		"ExtraDialogue_NewChild_FirstChild": "@, 너도 이제 아가가 아니구나. 진짜 아가가 생겼으니."
	}
